.{
    .name = .typebud,
    .version = "0.1.0",
    .fingerprint = 0xf88a70d101e1789,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // plyght/zpui @ d2074cd04a456fa109b9f2a7acf5926a0ab32e7d, checked out at ./zpui
        // (scripts/fetch-zpui.sh). A path dependency because zpui's package manifest only
        // lists src/, while its build.zig also needs vendor/ (lunasvg, stb).
        .zpui = .{ .path = "zpui" },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "tools", "third_party", "art", "sounds", "assets", "packaging" },
}
