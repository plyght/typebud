.{
    .name = .typebud,
    .version = "0.1.0",
    .fingerprint = 0xf88a70d101e1789,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // plyght/zpui @ 9a68bd67d98bd6a66d4cf7a289292832a9fcf3c9, checked out at ./zpui
        // (scripts/fetch-zpui.sh). A path dependency because zpui's package manifest only
        // lists src/, while its build.zig also needs vendor/ (lunasvg, stb).
        .zpui = .{ .path = "zpui" },
        // The over-the-air updater (its own package; docs/UPDATES.md).
        .updater = .{ .path = "updater" },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "tools", "third_party", "art", "sounds", "assets", "packaging", "updater" },
}
